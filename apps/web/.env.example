# apps/web environment. Copy to .env.local and fill in.
# Every variable is optional; the defaults below target a local validator.

# Which cluster this build talks to: devnet (default) or mainnet-beta. It
# picks the wallet signing chain (solana:devnet / solana:mainnet), hides the
# faucet, and switches the copy. Any other value fails the build. The mainnet
# Vercel project sets VITE_CLUSTER=mainnet-beta (see runbook.md, "Mainnet
# stack"); the devnet one leaves it unset or says devnet.
VITE_CLUSTER=devnet

# Solana RPC HTTP endpoint. Must be a public endpoint: Vite inlines this
# value into the shipped browser bundle, so a keyed URL placed here ships
# to every visitor. A localhost/127.0.0.1 host is what enables the dev
# burner wallet (see src/dev-burner.ts). Default: http://127.0.0.1:8899
# Never a Solami keyed endpoint: Vite inlines the key, and each browser's
# confirmTransaction opens a WebSocket against the plan's five-socket cap.
VITE_PUBLIC_RPC_URL=http://127.0.0.1:8899

# NestJS read API (apps/backend). Default: http://127.0.0.1:8080
VITE_API_URL=http://127.0.0.1:8080

# Overrides the program id baked into src/idl/hex_vault.json, for both PDA
# derivation (chain.ts) and the Anchor Program's address (App.tsx) — the same
# constant feeds both, so they cannot point at two different programs. Set it
# when the program is redeployed without re-running
# `pnpm --filter @hexvault/web sync-idl`, or when this build targets a
# non-dev environment (staging: apps/web/.env.staging.example; mainnet: see
# runbook.md "Mainnet stack"). A production build (`vite build`) throws at
# startup if this is unset; only a dev build falls back to the IDL's address.
VITE_PROGRAM_ID=LFk9ba6QXuM9oYRRNGGPxMGzfo13X3DAr8ghSPz72C6

# The pool this build talks to. Default: 1
VITE_POOL_ID=1

# Privy application id. Publishable by design. Set to "" or "off" to skip
# Privy and use standard injected Solana wallets instead. A production build
# throws at startup if this is unset entirely (missing, not "" or "off").
VITE_PRIVY_APP_ID=

# PostHog project key, the same one the landing page uses. Publishable by
# design. Empty disables analytics: no init, no network calls.
VITE_POSTHOG_KEY=

# Feature gates (ticket 01, feature-gates). "off" covers the feature with a
# same-sized Coming soon card; unset (the default here) means shown. Not
# required in production: unset is a valid production value.
# VITE_GATE_GAME=off
# VITE_GATE_JACKPOT=off
