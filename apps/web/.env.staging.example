# The VITE_* values for the Vercel Preview environment scoped to the `dev`
# branch (ticket 07). Not read by any build directly: paste these into
# Vercel's project settings (Environment Variables > Preview, restricted to
# the `dev` branch), not into a committed .env file. A Vercel variable only
# reaches the bundle on the next build, so redeploy after setting them.

# Devnet, same as the default dev build.
VITE_CLUSTER=devnet

# The staging backend (docker-compose.staging.yml + .env.staging).
VITE_API_URL=https://<staging-api-host>

# Public devnet endpoint; must stay public, Vite inlines it into the bundle.
VITE_PUBLIC_RPC_URL=https://api.devnet.solana.com

# The staging program id (ticket 06's `keys/hex_vault-staging-keypair.json`).
# Required: a production Vite build throws at startup without it.
VITE_PROGRAM_ID=H2iWyng2orJpHNGGWhrR7rBQNDqixThpTpAwF4dnPXax

# The pool bootstrap creates on the staging program. Update after bootstrap.
VITE_POOL_ID=1

# Privy application id, or "" / "off" to use injected Solana wallets instead.
# Required to be set to one of those three forms: a production Vite build
# throws at startup if it is missing entirely.
VITE_PRIVY_APP_ID=

# PostHog project key, the same one the landing page uses. Publishable by
# design. Empty disables analytics: no init, no network calls.
VITE_POSTHOG_KEY=

# Feature gates (ticket 01, feature-gates). "off" covers the feature with a
# same-sized Coming soon card; unset means shown. The game gate is lifted
# (off-chain-tickets 18: bets run through the API); the jackpot stays off until launch.
# VITE_GATE_GAME=off
VITE_GATE_JACKPOT=off
