# The VITE_* values for the Vercel Production environment (mainnet). Not read
# by any build directly: paste these into Vercel's project settings. A Vercel
# variable only reaches the bundle on the next build, so redeploy after setting.

VITE_CLUSTER=mainnet-beta

# Optional. Unset, the app uses api.mainnet-beta.solana.com, rate-limited per
# player IP. If set, use a public, origin-restricted key: Vite inlines it into
# the bundle.
VITE_PUBLIC_RPC_URL=
# Optional. Set when the RPC provider serves websockets on a different url
# than its https one (Solami). Unset, web3.js swaps https for wss on
# VITE_PUBLIC_RPC_URL, which is right for Helius. Sends confirm over this
# socket: if it cannot connect, every send reports expired.
VITE_PUBLIC_WS_URL=

VITE_API_URL=https://api.hexofun.lol
VITE_PROGRAM_ID=EwqRKGqnH7dGwL5ERMGQc2tsLKwT3duzKWPcCDphyPCH
VITE_POOL_ID=1
VITE_PRIVY_APP_ID=<privy app id>
VITE_POSTHOG_KEY=

# No VITE_BURNER_WALLET here. The dev burner is also off in any production
# build, whatever this variable says.
