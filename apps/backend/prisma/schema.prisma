// Mirrors the on-chain account layouts in programs/hex_vault/src/state.rs.
// spec.md §3.2. On-chain u64 -> BigInt, u128 -> Decimal(40, 0). Addresses and
// pubkeys are base58 strings; the API layer serializes BigInt/Decimal as
// decimal strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pool {
  address             String  @id
  poolId              BigInt
  /// Squads multisig on mainnet: set_params, unpause, set_operator.
  admin               String
  /// The hot crank key the backend signs with.
  operator            String
  /// Half of a two-step admin handover; null when no handover is open.
  pendingAdmin        String?
  mint                String
  epochSeconds        BigInt
  epochAnchor         BigInt
  minDeposit          BigInt
  paused              Boolean
  currentEpochId      BigInt
  currentEpochEndsAt  BigInt
  previousEpochEndsAt BigInt
  totalPrincipal      BigInt
  /// Requested withdrawals the principal vault still owes.
  pendingWithdrawals  BigInt
  /// An epoch closing under this rolls over instead of paying a token prize.
  minJackpot          BigInt
  /// The depositors' ceiling rate (APR, basis points). Since the live yield
  /// index it caps what depositors earn; the prize takes the rest.
  baseRateBps         Int
  /// Lets a future upgrade migrate an old account lazily (ADR 0013).
  version             Int
  /// Admin-only and irreversible: stops every inflow, the game and the
  /// draw, and lets withdrawals skip the epoch lock.
  shutdown            Boolean
  /// Game pause: the backend game engine opens no Round (game-jackpot-pause).
  gamePaused          Boolean @default(false)
  /// Jackpot pause: no new epoch, no ticket purchase, and an ended
  /// epoch does not request its draw (game-jackpot-pause).
  jackpotPaused       Boolean @default(false)
  /// Live yield (yield-claimer tickets 05 to 11). The defaults are what a
  /// pool row written before this migration reads; the next sync upserts the
  /// real values.
  /// The four pinned venue accounts; the names are klend's and the meaning follows venueKind. klend: program, lending market, reserve, the pool's cToken account. kVault: the kVault program, the vault state, the vault's shares mint, the pool's shares token account.
  klendProgram        String  @default("")
  klendMarket         String  @default("")
  klendReserve        String  @default("")
  klendCtoken         String  @default("")
  /// Which backing the four pins point at: 0 klend, 1 the localnet stub, 2 a Kamino Earn vault (kVault). A row written before the column reads as klend.
  venueKind           Int     @default(0)
  /// Per unit of Principal, scaled by 1e18.
  yieldIndex          Decimal @default(0) @db.Decimal(40, 0)
  venueValue          BigInt  @default(0)
  /// Chain unix seconds of the last on-chain sync.
  lastSyncAt          BigInt  @default(0)
  yieldOwed           BigInt  @default(0)
  feeOwed             BigInt  @default(0)
  prizeOwed           BigInt  @default(0)
  /// Jackpot already promised to a Drawing or Drawn epoch that has not paid. The vault holds it; the next draw snapshots the vault minus this.
  jackpotReserved     BigInt  @default(0)
  deficit             BigInt  @default(0)
  yieldFeeBps         Int     @default(0)
  idleFloorBps        Int     @default(0)
  idleTargetBps       Int     @default(0)
  reserveShareCapBps  Int     @default(0)
  reserveLiquidityFloorBps Int @default(0)
  minVenueMove        BigInt  @default(0)
  lossToleranceBps    Int     @default(0)
  deployPaused        Boolean @default(false)
  impaired            Boolean @default(false)
  buyTicketsPaused    Boolean @default(false)
  updatedSlot         BigInt

  // Back-relations for the pool-scoped tables (ADR 0016). A Pool row is
  // never deleted, so every child relation is onDelete: Restrict.
  epochs              Epoch[]
  players             Player[]
  events              Event[]
  cursor              Cursor?
  operatorState       OperatorState?
  referralGrants      ReferralGrant[]
  referralGrantShares ReferralGrantShare[]
  yieldIndexPoints    YieldIndexPoint[]
  venueProposal       VenueProposal?
}

// Pool-scoped tables carry poolAddress, the Pool PDA, as part of their key so
// the database keeps every pool it has mirrored and a Pool cutover needs no
// wipe (ADR 0016). The backend reads and writes the Active pool's rows only.

model Epoch {
  poolAddress       String
  pool              Pool     @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  id                BigInt
  startsAt          BigInt
  endsAt            BigInt
  status            Int
  jackpotAmount     BigInt
  target            Decimal  @db.Decimal(40, 0)
  winner            String?
  /// The Epoch snapshot's Merkle sum tree, taken by the Ticket ledger at the
  /// next `EpochBegan` (off-chain-tickets 11). Null until then. `snapshotRoot`
  /// is hex and stays null for an empty snapshot (leafCount 0, totalTickets 0).
  snapshotRoot      String?
  snapshotDepth     Int?
  leafCount         Int?
  totalTickets      BigInt?
  /// The `request_draw` nonce the Operator chose; written by the operator.
  nonce             BigInt?

  // Epoch ids restart at 1 on every pool (ADR 0016).
  @@id([poolAddress, id])
}

model Player {
  poolAddress  String
  pool         Pool    @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  owner        String
  principal    BigInt
  epochId      BigInt
  isHouse      Boolean
  /// Requested but not yet paid; `process_withdraw` pays it and zeroes it.
  pendingWithdraw BigInt
  /// The epoch the request was made in. It pays once the pool has moved past it.
  pendingEpoch    BigInt
  /// Chain unix seconds the pending withdrawal was last requested at. The
  /// request also matures one epoch length after this.
  requestedAt     BigInt @default(0)
  /// The pool's yield index at this Player's last settle, scaled by 1e18.
  /// Unsettled yield is principal x (pool.yieldIndex - this) / 1e18.
  yieldIndex         Decimal @default(0) @db.Decimal(40, 0)
  /// The part of principal deposited in pendingDepositEpoch, which earns no
  /// Ticket until the next epoch. Already inside principal.
  pendingDeposit      BigInt @default(0)
  pendingDepositEpoch BigInt @default(0)
  /// The epoch boughtAmount is counted against.
  boughtEpoch        BigInt
  /// USDC spent in buy_tickets so far in boughtEpoch, capped at principal.
  boughtAmount       BigInt
  /// The chain slot the mirror row was read at: the log path's notification
  /// slot or the sweep's snapshot slot. 0 for a row written before this
  /// column. `bindReferral` copies it to Referral.seedSlot.
  slot               BigInt @default(0)

  // On chain a Player is one wallet's account in one pool (ADR 0016). The
  // owner index serves the two cross-pool "has this wallet ever deposited"
  // checks: the beta gate and the referral apply.
  @@id([poolAddress, owner])
  @@index([owner])
}

// Finalized program events, decoded from `Program data:` logs. The key is
// already unique across pools; poolAddress scopes reads (ADR 0016).
model Event {
  slot        BigInt
  signature   String
  index       Int
  poolAddress String
  pool        Pool    @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  name        String
  data        Json
  blockTime   BigInt?
  /// True once the Ticket ledger has applied this event. Only the finalized
  /// catch-up path applies events, in chain order (off-chain-tickets 11).
  ledgered    Boolean @default(false)

  // Not keyed on slot: the live path stamps the slot its notification came
  // in, which a fork (and any RPC that notifies late) reports past the
  // transaction's own, so a slot in the key stored one event twice.
  @@id([signature, index])
  @@index([poolAddress, slot])
}

// The pool's open venue proposal (venue-switch ticket 03), one row per pool
// while the on-chain account exists. `propose_venue` upserts it, `cancel_venue`
// (and the migration, ticket 05) delete it. The unlock time is proposedAt plus
// the program's 48 hour lock, which is not stored.
model VenueProposal {
  poolAddress  String @id
  pool         Pool   @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  venueKind    Int
  klendProgram String
  klendMarket  String
  klendReserve String
  klendCtoken  String
  /// Chain unix seconds of the latest proposal.
  proposedAt   BigInt
  updatedSlot  BigInt
}

// One row per pool: the indexer's signature-catch-up cursor. A new pool has
// no row, so the indexer walks its history from the first signature (ADR
// 0016). `updatedAt` is unix seconds of the last successful sync, so GET
// /status can report a cursor age without guessing from the newest event's
// block time.
model Cursor {
  poolAddress   String  @id
  pool          Pool    @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  lastSignature String?
  lastSlot      BigInt?
  updatedAt     BigInt?
  /// The epoch the Ticket ledger has reached: the newest `EpochBegan` it applied.
  ledgerEpochId BigInt  @default(0)
}

// The pool's Yield index over time (yield-claimer ticket 14), one row per pool
// per minute at most, so a trailing paid rate can be worked out from two rows.
// `at` is the on-chain sync time the index was stamped with. The program
// stores no rate.
model YieldIndexPoint {
  poolAddress String
  pool        Pool    @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  at          BigInt
  yieldIndex  Decimal @db.Decimal(40, 0)

  @@id([poolAddress, at])
}

// The Ticket ledger (off-chain-tickets 11, ADR 0025). Append-only: no row is
// ever updated or deleted. No Pool relation, so the Pool model stays as it is.
enum TicketReason {
  reset
  stake
  reward
  refund
  house_credit
  prize
  withdraw
  buy
  grant_referral
  grant_admin
}

model TicketLedger {
  id          BigInt       @id @default(autoincrement())
  poolAddress String
  owner       String
  epochId     BigInt
  delta       BigInt
  reason      TicketReason
  /// The event key (`signature:index`), Round id or grant id that caused it.
  ref         String
  /// The wallet that signed the request; null for chain-driven rows.
  signer      String?
  /// Unique, so a signed grant resent inside its window is refused as a replay.
  signature   String?      @unique
  createdAt   DateTime     @default(now())

  @@index([poolAddress, owner])
}

// One row per wallet, in step with the ledger: `tickets` is the sum of the
// wallet's ledger deltas. `principal` and `yieldIndex` are the post-state fields
// of the newest chain event for the wallet.
model TicketBalance {
  poolAddress String
  owner       String
  tickets     BigInt   @default(0)
  principal   BigInt   @default(0)
  yieldIndex  Decimal  @default(0) @db.Decimal(40, 0)
  epochId     BigInt
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([poolAddress, owner])
}

// Every wallet above zero Tickets at an epoch's cutoff, sorted by wallet
// bytes. `index` is the leaf's position in the sum tree.
model EpochSnapshot {
  poolAddress String
  epochId     BigInt
  index       Int
  owner       String
  tickets     BigInt

  @@id([poolAddress, epochId, index])
}

// The newest ledger consistency check, one row per pool.
model LedgerCheck {
  poolAddress String @id
  checkedAt   BigInt
  mismatches  Int
}

model FaucetClaim {
  owner       String @id
  lastClaimAt BigInt
}

// Invite codes gate the private beta (docs/plan/hexo-referrals ticket 06).
// ownerWallet is indexed, not unique: the admin CLI may hand one wallet
// several codes, and the indexer only checks "does this wallet have one yet".
model InviteCode {
  code        String  @id
  ownerWallet String?
  maxUses     Int
  uses        Int     @default(0)
  createdAt   BigInt

  @@index([ownerWallet])
}

// No relation to InviteCode (or Referral.code): deleting a code is how one
// gets revoked, and that must leave redemptions already made intact.
model InviteRedemption {
  wallet     String @id
  code       String
  redeemedAt BigInt
}

// A depositor's own code (ADR 0014, docs/plan/referral-page ticket 01): one
// per wallet, unlimited uses, created by the indexer on that wallet's first
// Deposited event. Replaces the depositor-owned InviteCode ticket 06 used to
// create; admin-issued Invite codes are unaffected. No relation to
// InviteCode: generation checks both tables by hand (invite-code.ts) so a
// fresh code never collides with either.
model ReferralCode {
  code      String @id
  owner     String @unique
  createdAt BigInt
}

// Referral binding and qualification (docs/plan/hexo-referrals ticket 07).
// Written once, in the same transaction as the redeem that creates it
// (access.controller.ts); referrer, code and boundAt are never touched again.
model Referral {
  referee  String @id
  referrer String
  code     String
  boundAt  BigInt
  /// Unix seconds Principal last crossed up through 50 USDC; null while
  /// below it (or never having been above). Driven by the indexer off
  /// Deposited, WithdrawRequested, YieldCredited and compounded JackpotPaid.
  aboveSince BigInt?
  /// The referee's Principal as of the last Principal-changing event the
  /// indexer applied here. Not the live Player.principal: see referral.ts's
  /// ReferralQualificationState for why this is tracked independently.
  principal  BigInt  @default(0)
  /// The Player mirror's slot when `principal` was seeded at bind. The indexer
  /// skips this referee's events at or before it, since the seed already
  /// holds them. 0 means no seed to protect.
  seedSlot   BigInt  @default(0)

  @@index([referrer])
}

// One referrer's computed daily bonus for one epoch (docs/plan/hexo-referrals
// ticket 08). Since off-chain-tickets 22 the operator's job writes it in the
// same transaction as the referrer's `grant_referral` ledger row, so there is
// no send to wait for and `txSig` stays null. No @id: the unique index is the
// natural key and stops a second grant for the epoch. Keyed by pool as well:
// epoch ids restart on every pool (ADR 0016). The last three columns are the
// inputs `GET /epochs/:id/referral-grants` publishes.
model ReferralGrant {
  poolAddress    String
  pool           Pool    @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  epochId        BigInt
  referrer       String
  amount         BigInt
  /** referral-page ticket 04: `amount` without the own-Principal cap, pool
   *  scale-down still applied. Equal to `amount` when that cap doesn't
   *  bind. Migration 20260923020000 backfills existing rows to `amount`. */
  uncapped       BigInt
  qualifiedCount Int
  rateBps        Int
  txSig          String?
  /// The Referrer's own locked Principal when the grant was computed (the per-Referrer cap).
  referrerPrincipal BigInt @default(0)
  /// `total_principal` when computed, and the Game config's `bonusCapBps` in
  /// force then; the pool-wide cap is their product over 10,000.
  totalPrincipal BigInt  @default(0)
  bonusCapBps    Int     @default(0)

  @@unique([poolAddress, epochId, referrer])
}

// One referee's share of one referrer's ReferralGrant, epoch-scoped
// (referral-page ticket 05). Written by the same referral job, in the same
// transaction as the ReferralGrant row, so a Referrer has shares only if it
// has a grant. Split proportional to each qualified referee's own basis
// (min(Principal, REFERRAL_BONUS_BASIS_CAP)) at grant time, floored, with the
// leftover atomic units handed out by largest remainder (referral-bonus.ts's
// `splitShares`), so shares always sum exactly to the grant's `amount`. Keyed
// by pool like ReferralGrant (ADR 0016).
model ReferralGrantShare {
  poolAddress String
  pool        Pool   @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  epochId     BigInt
  referrer    String
  referee     String
  amount      BigInt
  /// The referee's locked Principal when the grant was computed.
  principal   BigInt @default(0)

  @@unique([poolAddress, epochId, referrer, referee])
}

// One row per pool: what the operator last did for it, for GET /status. A
// new pool has no row until its first tick (ADR 0016).
model OperatorState {
  poolAddress      String  @id
  pool             Pool    @relation(fields: [poolAddress], references: [address], onDelete: Restrict)
  lastTickAt       BigInt?
  /** Wall-clock unix seconds of the scheduler's next planned wake, so the
   *  web status summary can read a long deadline-driven sleep as live
   *  instead of stale (ticket 03, spec.md "Operator status learns about
   *  sleeping"). */
  nextWakeAt       BigInt?
  lastAction       String?
  lastError        String?
  /** How much the principal vault was short of the withdrawals due on the
   *  last tick that tried to pay them. 0 when the last try covered them all,
   *  null before any tick has looked. */
  withdrawShortfall BigInt?
  /** Ticket 06: owners step 6b has given up on for the rest of the epoch
   *  after too many consecutive failures. 0 when none have been, null before
   *  any tick has looked. */
  withdrawSkippedCount Int?
  /** Ticket 09: wall-clock unix seconds of the last tick that completed
   *  without an error, so OPERATOR_FAILING can tell "ticks are failing"
   *  from "ticks have stopped" (OPERATOR_STALE covers the latter). Null
   *  before the first successful tick. */
  lastSuccessAt    BigInt?
  /** Ticket 09: true on a tick whose previous epoch missed its expected
   *  deadline (epoch end + VRF timeout + slack) to
   *  reach a terminal status; false once one does. Null before any tick has
   *  ever looked. */
  epochNoProgress  Boolean?
  /** Ticket 09: true on a tick whose previous epoch drew a winner more than
   *  a few minutes ago and still has not been paid; false once it is. Null
   *  before any tick has ever looked. */
  drawnUnpaid      Boolean?
}

// beta-launch-fixes ticket 16: decoded send failures and error-boundary
// catches the web posts to POST /error-reports, so a broken money path
// reaches the maintainers instead of only the depositor's console.
// Write-only from the API's own perspective; nothing reads this back through
// a route, an operator queries Postgres directly.
model ErrorReport {
  id        Int      @id @default(autoincrement())
  code      String
  message   String
  signature String?
  wallet    String?
  page      String?
  createdAt DateTime @default(now())
}

// off-chain-tickets ticket 14: the game's parameters, append-only per pool.
// The newest row (highest id) is in force. A row with a null signer is the
// seed written on first run; every later row carries the team wallet's
// signed message. `signature` is unique so a signed change cannot be replayed
// after a newer one has landed.
model GameConfig {
  id             Int      @id @default(autoincrement())
  poolAddress    String
  roundSeconds   Int
  houseCutBps    Int
  ticketsPerUsdc Int
  bonusCapBps    Int
  /// [{ tier, min, max, rateBps }], highest tier first.
  referralTiers  Json
  maxTilesPerBet Int
  signer         String?
  signature      String?  @unique
  message        String?
  createdAt      DateTime @default(now())

  @@index([poolAddress, id])
}

// off-chain-tickets ticket 15: a wallet's signed delegation of a
// browser-held session key. One row per delegation; `sessionPubkey` is unique
// because the web mints a fresh key for every delegation. `message` and
// `signature` are the wallet's SIWS-shaped text and ed25519 signature, kept
// verbatim for the published Round record. No relation to Pool, so a Pool
// cutover leaves the table alone. `nextSeq` is the next bet's seq (ticket 16).
model Session {
  id            String    @id @default(uuid())
  poolAddress   String
  wallet        String
  sessionPubkey String    @unique
  message       String
  signature     String
  issuedAt      DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  nextSeq       Int       @default(0)

  @@index([wallet])
}

// Single-use nonces for the delegation message. Consumed by deleting the row.
model SessionNonce {
  nonce     String   @id
  expiresAt DateTime
}

// off-chain-tickets ticket 16: a Round of the off-chain game. No row exists
// until a bet is accepted. `seedSecret` is the unrevealed seed and is never
// served; `seed` stays null until reveal (ticket 17), when it takes the same
// value. `tileTotals` is 36 decimal strings, the Tickets staked on each tile.
// No relation to Pool, so a Pool cutover leaves the table alone.
enum RoundStatus {
  open
  closed
  revealed
  settled
  voided
}

model Round {
  poolAddress    String
  /// Per pool, from 1, in the order Rounds opened.
  id             BigInt
  epochId        BigInt
  openAt         DateTime
  closeAt        DateTime
  status         RoundStatus @default(open)
  seedCommitment String
  seedSecret     String
  seed           String?
  drandRound     BigInt?
  drandSignature String?
  ctr            Int?
  tile           Int?
  pot            BigInt      @default(0)
  houseCut       BigInt?
  tileTotals     Json
  /// sha256 of the accepted bets' raw signatures in order, hex; set at close.
  betListHash    String?
  configId       Int

  @@id([poolAddress, id])
  @@index([poolAddress, status])
}

// One accepted bet. `id` is the accepted order. `tiles` is a 36-bit mask, bit
// n set for tile n. One Position per wallet per Round is a rule of the engine,
// not of the table. `signature` is the session key's, base58.
model Position {
  id           BigInt   @id @default(autoincrement())
  poolAddress  String
  roundId      BigInt
  owner        String
  sessionId    String
  seq          Int
  tiles        BigInt
  stakePerTile BigInt
  message      String
  signature    String
  receivedAt   DateTime

  @@index([poolAddress, roundId, id])
  @@index([poolAddress, roundId, owner])
}
