# spec.md §3.1. Copy to .env and fill in.
DATABASE_URL=postgresql://hexvault:hexvault@localhost:5432/hexvault
# Devnet stays on Helius: Solami serves mainnet only. Mainnet takes either
# https://mainnet.helius-rpc.com/?api-key=YOUR_KEY or the Solami form
# https://rpc.solami.fast/sol?api_key=YOUR_KEY (runbook.md, "RPC providers").
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional. A second RPC (production-hardening ticket 03): a call that times
# out, or errors with a 5xx or a 429, on RPC_URL is retried once here. With a
# Solami RPC_URL on mainnet, put Helius here, so the fee estimator
# (getPriorityFeeEstimate) and getProgramAccountsV2 stay reachable on failover.
RPC_FALLBACK_URL=
# Optional, and only when RPC_URL is Solami: the WebSocket for subscriptions,
# wss://ws.solami.dev/ws/sol?api_key=YOUR_KEY. Empty derives the socket from
# RPC_URL, which is right for Helius, devnet and the fork.
RPC_WS_URL=
# Per-call timeout, in ms, every chain read and send is bounded by.
RPC_TIMEOUT_MS=10000
PROGRAM_ID=LFk9ba6QXuM9oYRRNGGPxMGzfo13X3DAr8ghSPz72C6
POOL_ID=1
# Checked against RPC_URL's genesis hash at boot (ticket 10): "devnet" or
# "mainnet-beta". A mismatch means the wrong RPC_URL for this deployment.
CLUSTER=devnet
OPERATOR_KEYPAIR=
# Optional. Base58 pubkey of the pool admin; no key for it lives here.
ADMIN_ADDRESS=
# The mint the pool takes deposits in. The old name HEXUSDC_MINT still works.
ACCEPTED_MINT=
# SOL below which /status and /healthz flag the operator as running out of fees.
OPERATOR_SOL_WARN=0.5
# Cap, in microlamports per compute unit, on the priority fee the operator
# attaches to land transactions during congestion (ticket 10).
PRIORITY_FEE_MAX_MICROLAMPORTS=50000
FAUCET_AMOUNT=1000000000
FAUCET_INTERVAL_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
PORT=8080
# Optional. Base58 secret of the Sparring player's wallet; `sparring-setup`
# prints one when this is empty.
SPARRING_KEYPAIR=
# The Sparring player plays only when this is true, keypair or not. Off by
# default (ADR 0019).
SPARRING_ENABLED=false
# Optional. Secret for POST /access/invites (header x-admin-key). Empty turns
# the route off. `openssl rand -hex 32`.
INVITE_ADMIN_KEY=
# Optional. Comma separated wallet public keys allowed to call POST
# /ops/fast-pause, which has the Operator key set a pause switch (never clear
# one). Empty turns the route off (404). A bad entry refuses to boot.
OPS_WALLETS=
# Optional. Invite code quota: a redeem grants the redeemer this many
# single-use codes of its own, while fewer than INVITE_CIRCULATION_CAP unused
# uses are in circulation. Defaults 2 and 50.
INVITE_REDEEM_GRANT_COUNT=
INVITE_CIRCULATION_CAP=
# Optional. ISO timestamp (beta-launch-fixes ticket 05): holds the Operator's
# first begin_epoch back until this instant, so the pool can take deposits
# for a launch week before the first Epoch/Draw exists. Empty or unset
# behaves as before: begin_epoch fires on the first tick. Malformed values
# refuse to boot.
LAUNCH_AT=
# Optional, mainnet only; unset to send through the RPC (Solami ticket 08).
# Base58 secret of the swQoS key from Solami's dashboard: operator sends carry
# a BEAM_TIP_LAMPORTS tip (default and minimum 100000) and go to Beam first.
BEAM_KEYPAIR=
BEAM_TIP_LAMPORTS=
