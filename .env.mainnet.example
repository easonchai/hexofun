# Copy to .env.mainnet on the VPS and fill in. This is the mainnet twin of
# .env.example, and the two stacks run side by side from the same
# docker-compose.yml. Bring this one up with:
#
#   docker compose --env-file .env.mainnet up -d --build
#
# --env-file makes compose interpolate from this file instead of .env, which is
# how the three COMPOSE_* / STACK_NAME / ENV_FILE keys below take effect. The
# devnet stack keeps using the plain `docker compose` command and .env.
#
# Keep every value free of `$`: compose expands it in this file.
# `.env.mainnet` is gitignored by the `.env.*` rule. Never commit real keys.

# --- Stack identity. Only this stack sets these. -------------------------
# Docker project name. Separates containers, networks and the postgres volume
# from the devnet stack's `hexvault`.
COMPOSE_PROJECT_NAME=hexvault-mainnet
# Prefix for the Traefik router and service names, so the two stacks do not
# claim the same router. Gives hexvault-mainnet-api.
STACK_NAME=hexvault-mainnet
# The file compose hands to the backend container as its environment. Must name
# this file.
ENV_FILE=.env.mainnet

# --- Host and Traefik. You supply these. ---------------------------------
# Hostname Traefik routes to the mainnet API. Its own DNS record, separate from
# the devnet API host, pointing at the same box.
API_HOST=api.hexofun.lol
# Same Traefik instance and certresolver as the devnet stack.
TRAEFIK_NETWORK=traefik
CERT_RESOLVER=letsencrypt

# --- Postgres. Own database, own volume. ---------------------------------
# The volume is named after COMPOSE_PROJECT_NAME, so it is already separate.
# The database name differs too, so a psql session cannot hit the wrong one.
POSTGRES_USER=hexvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hexvault_mainnet

# --- Chain. You supply these. --------------------------------------------
# Helius mainnet HTTPS url, on a Helius key of its own. Do not reuse the devnet
# key: the two stacks would share one rate limit and one bill.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_MAINNET_KEY
# A second mainnet RPC provider (ticket 03), a different provider than
# RPC_URL: a call that times out, or errors with a 5xx or a 429, on RPC_URL
# is retried once here. Real money is at stake here, unlike devnet/staging,
# so this should not be left empty at launch.
RPC_FALLBACK_URL=
# Per-call timeout, in ms, every chain read and send is bounded by.
RPC_TIMEOUT_MS=10000
# Mainnet's own program keypair (ops-and-envs ticket 06), not the devnet/
# localnet id above: dev, staging and mainnet each get a separate `declare_id!`,
# chosen by the `mainnet` cargo feature at build time. Matches
# keys/hex_vault-mainnet-keypair.json.
PROGRAM_ID=EwqRKGqnH7dGwL5ERMGQc2tsLKwT3duzKWPcCDphyPCH
# Checked against RPC_URL's genesis hash at boot (ticket 10). Must be
# mainnet-beta here; a mismatch means the wrong RPC_URL.
CLUSTER=mainnet-beta
# Base58 secret of the Operator hot key. It cranks rounds and epochs and holds
# no user funds. On launch day it is also the deploy key and pays the pool's
# creation. `scripts/mainnet-keys.sh` makes it and fills in both lines below.
# /status and /healthz warn below 0.5 SOL.
OPERATOR_KEYPAIR=
# Laptop only: the same key as a keypair file, which `scripts/deploy.sh
# mainnet` points the solana CLI at. Not read by the backend; harmless on the
# box, where the file does not exist.
DEPLOY_KEYPAIR=
# Admin pubkey, the Squads multisig. Read for CLI targeting only, never a key.
# On mainnet's genesis hash, bootstrap refuses to run without this (or
# --admin), refuses it equal to the Operator key, and never creates a mint.
ADMIN_ADDRESS=
# The Pool's Treasury and Buyback reserve token accounts. Bootstrap creates
# both owned by ADMIN_ADDRESS when --treasury and --buyback-reserve are not
# passed, and prints them; paste them here before the first boot. Required on
# mainnet-beta: every start compares them, ADMIN_ADDRESS and the venue
# (VENUE_KIND, KLEND_*, KVAULT_ADDRESS from bootstrap's output; Kamino's USDC
# reserve when unset) with the on-chain Pool and refuses to boot on any
# difference, so a Pool someone else created cannot be mistaken for yours.
# After a venue migration, update the venue keys too.
TREASURY=
BUYBACK_RESERVE=
# Optional. Base58 secret of the Sparring player's wallet. sparring-setup does
# not mint on mainnet, so the wallet must already hold its deposit. It only
# plays when SPARRING_ENABLED=true, which this file does not set (ADR 0019).
SPARRING_KEYPAIR=
# Optional. Secret for POST /access/invites (header x-admin-key). Empty turns
# the route off. `openssl rand -hex 32`.
INVITE_ADMIN_KEY=
# Optional. Comma separated wallet public keys allowed to call POST
# /ops/fast-pause, which has the Operator key set a pause switch (never clear
# one). Empty turns the route off (404). A bad entry refuses to boot.
OPS_WALLETS=
# Optional. Invite code quota: a redeem grants the redeemer this many
# single-use codes of its own, while fewer than INVITE_CIRCULATION_CAP unused
# uses are in circulation. Defaults 2 and 50.
INVITE_REDEEM_GRANT_COUNT=
INVITE_CIRCULATION_CAP=
# Optional. ISO timestamp (beta-launch-fixes ticket 05): holds begin_epoch
# back for a deposit-only launch week. See runbook.md "Launch week".
LAUNCH_AT=

# --- Pool. ----------------------------------------------------------------
# First mainnet pool. Pool ids are global, but each cluster has its own chain,
# so mainnet starts again at 1.
POOL_ID=1
# Real USDC on mainnet-beta. No faucet, no bootstrap-created mint.
ACCEPTED_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Bought Tickets ship paused on mainnet (ADR 0019). Bootstrap defaults this to
# true on mainnet-beta; it is spelled out here so the file says so. Only the
# Admin can send set_buy_tickets_pause, so with a multisig Admin bootstrap
# warns and the Admin pauses (and later unpauses) from the multisig.
BUY_TICKETS_PAUSED=true

# The venue create_pool pins on the Pool for good. Bootstrap defaults to
# Kamino's USDC reserve on the main market and creates the pool's cToken ATA;
# leave these empty to take that. Setting KLEND_RESERVE needs KLEND_CTOKEN too.
# The Pool's read-back is printed at the end of bootstrap: have a second person
# check it against Kamino before anything is deployed.
KLEND_PROGRAM=
KLEND_MARKET=
KLEND_RESERVE=
KLEND_CTOKEN=

# --- Pool tuning. Defaults from spec §7; the backend falls back to these. --
# SOL below which /status and /healthz flag the operator as running out of fees.
OPERATOR_SOL_WARN=0.5
# Cap, in microlamports per compute unit, on the priority fee the operator
# attaches to land transactions during congestion (ticket 10).
PRIORITY_FEE_MAX_MICROLAMPORTS=50000

# --- API. ----------------------------------------------------------------
# Origin of the mainnet Vercel project, comma-separated if there is more than
# one. No localhost here.
CORS_ORIGIN=https://app.hexofun.lol
# compose pins the container to 8080 to match the Traefik service label.
PORT=8080

# --- Beam (Solami ticket 08). Mainnet only; unset to send through the RPC. --
# Base58 secret of the swQoS key from Solami's dashboard. Set, operator sends
# carry a tip and go to Beam first. See runbook.md "Beam".
BEAM_KEYPAIR=
# Lamports tipped per send. Default and minimum 100000 (0.0001 SOL).
BEAM_TIP_LAMPORTS=

# --- Subgraph (Solami ticket 05). Both or neither; unset keeps the RPC walk. --
# The hexo subgraph's GraphQL endpoint and the Solami key sent as its bearer.
# Set once the deployment's status is Live. The Indexer's catch-up reads it
# while it is within 300 slots of the chain head.
# SUBGRAPH_URL=https://api.solami.dev/index/hexo/graphql
SUBGRAPH_URL=
SUBGRAPH_API_KEY=
