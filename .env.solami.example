# Copy to .env.solami for scripts/subgraph.sh (runbook.md, "Subgraph").
# .env.solami is gitignored by the .env.* rule. Never commit a real key.

# Solami API key, sent as Authorization: Bearer on every call.
SOLAMI_API_KEY=
# The mainnet HexVault program id. Compiled into the wasm and written into the manifest.
SUBGRAPH_PROGRAM_ID=
# First slot the subgraph indexes. On the Free tier (no backfill) the current slot, before the pool exists.
SUBGRAPH_START_SLOT=
