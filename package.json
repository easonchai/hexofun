{
  "name": "hexvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solana active prize-linked savings protocol prototype",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "lint": "pnpm -r --if-present lint",
    "test:unit": "pnpm -r --if-present test",
    "check:sh": "shellcheck -S warning -e SC1007,SC1090 scripts/*.sh apps/*/scripts/*.sh .husky/pre-push",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.1.2",
    "@solana/kit": "8.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/web3.js": "1.98.4",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "commander": "15.0.0",
    "fastify": "5.12.1",
    "husky": "9.1.7",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "playwright": "^1.62.1",
    "prettier": "3.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "3.2.4"
  }
}
