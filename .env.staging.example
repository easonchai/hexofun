# Copy to .env.staging on the VPS and fill in. This is the staging twin of
# .env.example: a third stack, running side by side with devnet and mainnet
# from the same docker-compose.yml (included by docker-compose.staging.yml).
# Bring it up with:
#
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build
#
# --env-file makes compose interpolate from this file instead of .env, which is
# how the three COMPOSE_* / STACK_NAME / ENV_FILE keys below take effect. The
# devnet stack keeps using the plain `docker compose` command and .env; the
# mainnet stack keeps using `docker compose --env-file .env.mainnet`.
#
# Keep every value free of `$`: compose expands it in this file.
# `.env.staging` is gitignored by the `.env.*` rule. Never commit real keys.

# --- Stack identity. Only this stack sets these. -------------------------
# Docker project name. Separates containers, networks and the postgres volume
# from the devnet stack's `hexvault` and the mainnet stack's `hexvault-mainnet`.
COMPOSE_PROJECT_NAME=hexvault-staging
# Prefix for the Traefik router and service names, so no stack claims the
# same router. Gives hexvault-staging-api.
STACK_NAME=hexvault-staging
# The file compose hands to the backend container as its environment. Must name
# this file.
ENV_FILE=.env.staging

# --- Host and Traefik. You supply these. ---------------------------------
# Hostname Traefik routes to the staging API. Its own DNS record, separate
# from the devnet and mainnet API hosts, pointing at the same box.
API_HOST=<staging-api-host>
# Same Traefik instance and certresolver as the other stacks.
TRAEFIK_NETWORK=traefik
CERT_RESOLVER=letsencrypt

# --- Postgres. Own database, own volume. ---------------------------------
# The volume is named after COMPOSE_PROJECT_NAME, so it is already separate.
POSTGRES_USER=hexvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hexvault_staging

# --- Chain. You supply these. --------------------------------------------
# Helius devnet HTTPS url. Staging shares devnet as its cluster (ticket 07:
# dev and staging are both devnet programs, just different program ids and
# boxes), but give it its own Helius key so it has its own rate limit.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_STAGING_KEY
# Optional. A second RPC provider (ticket 03): a call that times out, or
# errors with a 5xx or a 429, on RPC_URL is retried once here.
RPC_FALLBACK_URL=
# Per-call timeout, in ms, every chain read and send is bounded by.
RPC_TIMEOUT_MS=10000
# The staging program id (ticket 06's `keys/hex_vault-staging-keypair.json`).
# Must match declare_id! built with `--features staging`.
PROGRAM_ID=H2iWyng2orJpHNGGWhrR7rBQNDqixThpTpAwF4dnPXax
# Checked against RPC_URL's genesis hash at boot (ticket 10). Staging runs
# against devnet's RPC, so this stays "devnet" even though it is a separate
# program id from the plain devnet deployment above.
CLUSTER=devnet
# Base58 secret key of the Operator's hot key. `solana-keygen new`, then
# airdrop devnet SOL to it. It signs every crank; it never holds user funds.
OPERATOR_KEYPAIR=
# Optional. Base58 pubkey of the pool admin (parameters, unpause, principal).
# No key for it lives here. Empty means the loaded keypair is the admin too.
ADMIN_ADDRESS=
# Optional. Base58 secret key of the Sparring player's wallet, which buys one
# Position per Round. It only plays when SPARRING_ENABLED=true, which this
# file does not set (ADR 0019).
SPARRING_KEYPAIR=

# Optional. Secret for POST /access/invites (header x-admin-key), so invite
# codes can be minted without VPS access. Empty turns the route off.
# Generate with `openssl rand -hex 32`.
INVITE_ADMIN_KEY=
# Optional. Invite code quota: a redeem grants the redeemer this many
# single-use codes of its own, while fewer than INVITE_CIRCULATION_CAP unused
# uses are in circulation. Defaults 2 and 50.
INVITE_REDEEM_GRANT_COUNT=
INVITE_CIRCULATION_CAP=
# Optional. ISO timestamp (beta-launch-fixes ticket 05): holds begin_epoch
# back for a deposit-only launch week. See runbook.md "Launch week".
LAUNCH_AT=

# --- Produced by bootstrap (ticket 09). Paste its output over these. ------
POOL_ID=1
# The test mint bootstrap creates on devnet for the staging program. Empty
# until bootstrap has run once against PROGRAM_ID above.
ACCEPTED_MINT=

# --- Pool tuning. Defaults from spec §7; the backend falls back to these. --
OPERATOR_SOL_WARN=0.5
PRIORITY_FEE_MAX_MICROLAMPORTS=50000
FAUCET_AMOUNT=1000000000
FAUCET_INTERVAL_SECONDS=3600

# --- create_pool defaults (bootstrap only; ADR 0011). --------------------
BASE_RATE_BPS=488
TICKETS_PER_USDC=10
BONUS_CAP_BPS=500
# The venue create_pool pins on the Pool for good (bootstrap only). Devnet has
# no default: name the klend program, lending market, USDC reserve and the
# pool's cToken account (the pool PDA's ATA of the reserve's cToken mint, which
# must exist before the first deploy). See .env.example.
KLEND_PROGRAM=
KLEND_MARKET=
KLEND_RESERVE=
KLEND_CTOKEN=

# --- Referrals (ticket 07/08). --------------------------------------------
REFERRAL_QUALIFY_SECONDS=604800

# --- API. ----------------------------------------------------------------
# The Vercel Preview origin for the `dev` branch (see apps/web/.env.staging.example).
CORS_ORIGIN=https://<preview-host>.vercel.app
PORT=8080
