#!/usr/bin/env sh
# Ops-and-envs ticket 14: stops a test-vrf build or a failing unit test from
# leaving the laptop. No CI, by decision, so this is the only gate.
#
# check-deployable.sh needs a built .so, which most pushes have not run
# anchor build for, so a missing artifact skips the check instead of failing
# the push. `git push --no-verify` is the documented escape hatch (runbook.md).

if [ -f target/deploy/hex_vault.so ]; then
  sh scripts/check-deployable.sh
else
  echo "pre-push: no target/deploy/hex_vault.so, skipping check-deployable" >&2
fi

pnpm check:sh

pnpm test:unit

# Typechecks backend and web (unused locals included) and, from production-
# hardening ticket 07, fails if a provider key lands in the web bundle.
pnpm check
